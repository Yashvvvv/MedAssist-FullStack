# Copy to .env for docker compose, or set these in Render's dashboard.
# Only DATABASE_* and JWT_SECRET are required; everything else has a safe default
# or turns a feature off when empty.

# --- Database (local compose uses the postgres service below) ---------------
# Supabase: use the SESSION pooler (port 5432), not the transaction pooler (6543):
# Flyway and JDBC prepared statements need a real session.
# DATABASE_URL=jdbc:postgresql://aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=jdbc:postgresql://localhost:5432/medassist
DATABASE_USERNAME=medassist
DATABASE_PASSWORD=medassist
DB_POOL_SIZE=5

# --- Security ------------------------------------------------------------------
# At least 32 random bytes. Generate: openssl rand -base64 48
JWT_SECRET=
PUBLIC_BASE_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Demo data (public credentials; never on a deployment with real data) ----
DEMO_DATA=false

# --- File storage: local (ephemeral on Render free) | supabase -----------------
STORAGE_PROVIDER=local
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
STORAGE_BUCKET=medassist

# --- AI (Gemini): prescription reading, medicine Q&A, substitutes ------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Email (verification, password reset, invites); empty = log only ---------
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=MedAssist <no-reply@example.com>

# --- Billing: manual (owner switches plan in-app) | razorpay ------------------
BILLING_PROVIDER=manual
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_PRO=
RAZORPAY_PLAN_BUSINESS=
